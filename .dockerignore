# Локальные модули — будут установлены внутри контейнера
node_modules/

# Лог-файлы и временные файлы
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Файлы окружения (особенно .env с паролями!) — не должны попадать в образ
.env
.env.*
!.env.example   # если есть шаблон, его можно оставить

# Системные файлы
.DS_Store
Thumbs.db

# Директория для данных PostgreSQL (локально может не быть, но на всякий случай)
pgdata/

# Исходники и инструменты, не нужные в продакшене
.git/
.gitignore
README.md
docker-compose.yml
Dockerfile.dev
.dockerignore

# Папка для временных файлов сборки, если есть
build/
dist/
.nyc_output/
coverage/